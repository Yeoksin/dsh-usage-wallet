{
  "name": "dsh-usage-wallet",
  "version": "1.0.0",
  "description": "DSH sidebar widget that shows the active provider's balance or subscription usage — Alibaba Cloud voucher balance (BSS OpenAPI + AccessKey), Xiaomi MiMo console balance and token-plan usage, plus DeepSeek/Moonshot/Z.ai/OpenRouter balances and Kimi/MiniMax/OpenCode quotas — with per-token unit prices, a provider query-status page, and Chinese/English UI.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "upstream:sync": "node scripts/sync-upstream.mjs"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "NOTICE.md",
    "screenshot.png",
    "screenshots.json",
    "install.bat",
    "install.ps1",
    "fix-bom.ps1",
    "TROUBLESHOOTING.md",
    "install-offline.bat",
    "screenshot-balance.png"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6 || ^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.2.0-rc.1 || ^0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "usage",
    "quota",
    "wallet",
    "aliyun",
    "qwen",
    "mimo",
    "xiaomi"
  ],
  "license": "MIT",
  "private": true,
  "author": "fork by the repository owner; original plugin by dougen (MIT)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yeoksin/dsh-usage-wallet.git"
  },
  "homepage": "https://github.com/Yeoksin/dsh-usage-wallet#readme",
  "bugs": {
    "url": "https://github.com/Yeoksin/dsh-usage-wallet/issues"
  }
}
